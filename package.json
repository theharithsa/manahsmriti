{
  "name": "manahsmriti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Manahsmriti — a home for personal projects, starting with a searchable, cloud-synced book catalog.",
  "scripts": {
    "dev": "vite books --host 0.0.0.0",
    "build": "vite build books",
    "preview": "vite preview books --host 0.0.0.0",
    "test:rules": "firebase emulators:exec --only firestore --project demo-manahsmriti 'node --test tests/firestore.test.mjs'",
    "deploy:books": "npm run build && node scripts/deploy-books.mjs",
    "provision:books": "node scripts/provision-books.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:catalog": "node --test tests/catalog.test.mjs",
    "test:emulators": "firebase emulators:exec --only auth,firestore --project demo-manahsmriti \"npm run test:rules:direct && npm run test:browser\"",
    "test:rules:direct": "node --test tests/firestore.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ancizar-serif": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^14.0.0",
    "vite": "^7.0.0"
  }
}
